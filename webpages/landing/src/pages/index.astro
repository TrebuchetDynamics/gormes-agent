---
import BaseDocument from '../components/BaseDocument.astro';
import { page } from '../data/landing.js';
import { site } from '../data/site.js';

const sectionShell = 'mx-auto max-w-6xl px-5 sm:px-7 lg:px-8';
const sectionPad = 'py-14 sm:py-18 lg:py-20';
const cardShell = 'glass-card rounded-2xl border border-white/10 bg-white/[0.045] p-5 shadow-[0_18px_60px_rgba(0,0,0,0.22)]';
const buttonBase = 'btn inline-flex min-h-11 items-center justify-center rounded-full px-5 py-2.5 text-sm font-bold transition hover:border-transparent focus-visible:rounded-full';
const buttonPrimary = `${buttonBase} btn-primary bg-[#f0c84b] text-[#171000] shadow-[0_12px_34px_rgba(240,200,75,0.24)] hover:bg-[#ffd968]`;
const buttonSecondary = `${buttonBase} btn-secondary border border-white/15 bg-white/[0.055] text-[#eeece5] hover:border-[#f0c84b]/70 hover:text-[#f0c84b]`;
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Gormes',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows, Android/Termux',
  url: page.siteUrl,
  description: page.description,
  softwareVersion: page.releaseTag,
  license: 'https://opensource.org/license/mit',
  codeRepository: site.githubUrl,
  downloadUrl: site.installScriptUrl,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: site.publisherName,
    url: site.publisherUrl,
  },
};
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.publisherName,
  url: site.publisherUrl,
  sameAs: ['https://github.com/TrebuchetDynamics'],
};
---

<BaseDocument
  title={page.title}
  description={page.description}
  canonicalUrl={page.siteUrl}
  keywords="Go AI agent runtime, local AI agent runtime, single binary AI agent, offline AI runtime, AI agent memory, AI gateway runtime, Hermes agent alternative, Android Termux AI agent"
  socialUrl={page.siteUrl}
  socialImageAlt="Gormes runs AI agents anywhere from one Go binary"
  structuredData={[softwareSchema, organizationSchema]}
>
  <link slot="head" rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar sticky top-0 z-50 border-b border-white/10 bg-[#090b0f]/78 backdrop-blur-xl supports-[backdrop-filter]:bg-[#090b0f]/64">
      <div class={`${sectionShell} topbar-inner flex items-center justify-between gap-5 py-4`}>
        <a class="brand inline-flex min-w-0 items-center border-0 hover:opacity-90" href="#top" aria-label="Gormes">
          <img
            class="h-auto w-[168px] max-w-[44vw] sm:w-[220px]"
            src="/static/gormes-agent-logo-blue.svg"
            alt="Gormes"
            width="1200"
            height="150"
          />
        </a>
        <nav aria-label="Primary">
          <ul class="topnav m-0 flex list-none flex-wrap justify-end gap-2 p-0 text-xs font-bold uppercase text-[#eeece5]/65 sm:gap-3" role="list">
            {page.nav.map((link) => (
              <li>
                <a class="rounded-full border border-transparent px-2.5 py-1.5 hover:border-white/10 hover:bg-white/[0.055] hover:text-[#eeece5]" href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <section id="top" class="hero relative isolate overflow-hidden border-b border-white/10">
        <img
          class="pointer-events-none absolute right-[-62px] top-10 z-0 hidden h-auto w-[360px] opacity-[0.18] sm:block md:right-[-36px] md:w-[430px] lg:right-8 lg:opacity-[0.28]"
          src="/static/go-gopher-bear-lowpoly.png"
          alt="Gormes Go-native AI agent runtime mascot"
          width="800"
          height="800"
          fetchpriority="low"
          decoding="async"
        />
        <div class={`${sectionShell} hero-inner relative z-10 grid gap-10 py-16 sm:py-20 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,0.72fr)] lg:items-center lg:py-24`}>
          <div class="hero-content min-w-0 max-w-3xl">
            <p class="kicker mb-4 text-xs font-bold uppercase tracking-[0.2em] text-[#73cedd]">{page.heroKicker}</p>
            <h1 class="hero-title mb-5 max-w-[820px] text-balance font-serif text-[clamp(2.45rem,7.8vw,5.35rem)] font-black leading-[0.95] tracking-[-0.045em] text-white">
              {page.heroHeadline}
            </h1>
            <div class="hero-subhead max-w-2xl text-pretty text-base leading-7 text-[#eeece5]/[0.76] sm:text-lg">
              {page.heroLines.map((line) => <p>{line}</p>)}
            </div>
            <div class="hero-ctas mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a class={buttonPrimary} href={page.primaryCta.href}>{page.primaryCta.label}</a>
              <a class={buttonSecondary} href={page.secondaryCta.href}>{page.secondaryCta.label}</a>
              <a class="inline-flex min-h-11 items-center justify-center rounded-full px-2 py-2 text-sm font-bold text-[#f0c84b] hover:text-[#ffd968] sm:justify-start" href={page.tertiaryCta.href}>{page.tertiaryCta.label}</a>
            </div>
            <div class="proof-strip mt-6 flex flex-wrap gap-2">
              {page.proofStrip.map((item) => (
                <span
                  class={`proof-item rounded-full border px-3 py-1 text-xs font-bold ${
                    item.kind === 'pop'
                      ? 'proof-item-pop border-[#f0c84b]/55 bg-[#f0c84b]/10 text-[#f0c84b]'
                      : 'border-white/10 bg-white/[0.035] text-[#eeece5]/75'
                  }`}
                >
                  {item.label}
                </span>
              ))}
            </div>
          </div>

        </div>
      </section>

      <section id="why" class={`why border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} why-inner`}>
          <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">{page.whyLabel}</p>
          <h2 class="section-title mb-5 max-w-2xl text-2xl font-bold text-[#eeece5]">{page.whyPainHeadline}</h2>
          <p class="max-w-3xl text-base leading-7 text-[#eeece5]/70">{page.whyPainIntro}</p>
          <div class="why-card-grid mt-8 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
            {page.whyCards.map((card) => (
              <article class={`${cardShell} why-card min-w-0 transition duration-200 hover:-translate-y-0.5 hover:border-[#73cedd]/28 hover:bg-white/[0.065]`}>
                <h3 class="text-base font-bold text-[#eeece5]">{card.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[#eeece5]/70">{card.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="install" class={`install border-b border-white/10 ${sectionPad}`}>
        <div class={`${sectionShell} install-inner`}>
          <div class="install-header max-w-2xl">
            <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">FIRST RUN</p>
            <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.installHeadline}</h2>
            <p class="install-intro text-base leading-7 text-[#eeece5]/70">{page.installIntro}</p>
          </div>
          <figure class={`${cardShell} install-step mt-8 flex min-w-0 flex-col gap-4`}>
            <figcaption class="flex flex-wrap items-center justify-between gap-3">
              <span class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-[#f0c84b]">Linux, macOS, WSL2</span>
              <button
                class="copy-btn inline-flex min-h-8 items-center rounded-full border border-white/15 px-3 py-1.5 font-mono text-xs font-bold text-[#eeece5]/70 transition hover:border-[#f0c84b]/70 hover:text-[#f0c84b]"
                type="button"
                data-copy-command
                aria-label="Copy install command"
              >
                <span class="copy-label">Copy</span>
              </button>
            </figcaption>
            <pre class="cmd min-w-0 overflow-x-auto rounded-xl bg-[#05070a] p-4 text-sm leading-6 text-[#eeece5]" tabindex="0"><code>{page.installCommand}</code></pre>
          </figure>
          <p class="install-footnote mt-6 text-sm text-[#eeece5]/65">
            {page.installFootnote}
            <a class="ml-1 font-bold text-[#f0c84b] hover:text-[#ffd968]" href={page.installFootnoteLink.href}>
              {page.installFootnoteLink.label}
            </a>
          </p>
        </div>
      </section>

    </main>

    <footer class="footer border-t border-white/10 bg-[#05070a]">
      <div class={`${sectionShell} footer-inner py-8`}>
        <nav class="footer-nav flex flex-wrap gap-3 text-sm font-bold text-[#eeece5]/65" aria-label="Secondary">
          {page.footerNav.map((link) => <a class="hover:text-[#f0c84b]" href={link.href}>{link.label}</a>)}
        </nav>
        <div class="footer-meta mt-4 flex flex-col gap-2 text-sm text-[#eeece5]/55 sm:flex-row sm:items-center sm:justify-between">
          <p class="footer-left">
            {page.footerRelease} · <a class="hover:text-[#f0c84b]" href="https://trebuchetdynamics.com/">TrebuchetDynamics</a>
          </p>
          <p class="footer-right">MIT License · 2026</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const button = target.closest('[data-copy-command]');
        if (!button) {
          return;
        }

        const step = button.closest('.install-step');
        const code = step?.querySelector('code')?.innerText || '';
        const label = button.querySelector('.copy-label');
        const original = label?.textContent || 'Copy';

        try {
          await navigator.clipboard.writeText(code);
          if (label) {
            label.textContent = 'Copied';
          }
          button.classList.add('copied');
          setTimeout(() => {
            if (label) {
              label.textContent = original;
            }
            button.classList.remove('copied');
          }, 1500);
        } catch {
          if (label) {
            label.textContent = 'Copy failed';
            setTimeout(() => {
              label.textContent = original;
            }, 1500);
          }
        }
      });
    </script>
</BaseDocument>
