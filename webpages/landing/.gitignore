.deploy-trigger

# ── Progress SSoT mirror (checked in; root .gitignore excludes data/) ─
!src/data/
!src/data/benchmarks.json
# src/data/progress.json was a dead 5.2 MB verbatim backlog mirror with no
# Astro consumer (backlog-efficiency #1, 2026-05-16). It is no longer
# generated or tracked — the landing roadmap renders from the slim go:embed
# mirror in legacy/go-renderer, regenerated by `go run ./cmd/progress write`.
# This ignore must stay AFTER `!src/data/` so it wins (last match).
src/data/progress.json
