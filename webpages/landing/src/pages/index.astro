---
import '../styles/global.css';
import { page, roadmapPhases, trackerLabel } from '../data/landing.js';

const statusClasses = {
  shipped: 'border-emerald-300/30 bg-emerald-300/10 text-emerald-200',
  progress: 'border-cyan-300/30 bg-cyan-300/10 text-cyan-200',
  planned: 'border-yellow-300/30 bg-yellow-300/10 text-yellow-100',
  later: 'border-indigo-300/30 bg-indigo-300/10 text-indigo-100',
  ongoing: 'border-cyan-300/30 bg-cyan-300/10 text-cyan-200',
  pending: 'border-yellow-300/30 bg-yellow-300/10 text-yellow-100',
};

const sectionShell = 'mx-auto max-w-5xl px-5 sm:px-7';
const sectionPad = 'py-16 sm:py-20';
const cardShell = 'rounded-lg border border-white/10 bg-white/[0.035] p-5 shadow-[0_1px_0_rgba(255,255,255,0.04)_inset]';
const buttonBase = 'btn inline-flex min-h-11 items-center justify-center rounded-md px-4 py-2 text-sm font-bold transition hover:border-transparent focus-visible:rounded-md';
const buttonPrimary = `${buttonBase} btn-primary bg-[#f0c84b] text-[#171000] hover:bg-[#ffd968]`;
const buttonSecondary = `${buttonBase} btn-secondary border border-white/15 bg-white/[0.035] text-[#eeece5] hover:border-[#f0c84b]/70 hover:text-[#f0c84b]`;
---

<!doctype html>
<html lang="en" data-site-runtime="astro-tailwind">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gormes" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content="https://gormes.ai/" />
    <meta property="og:image" content="https://gormes.ai/static/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={page.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content="https://gormes.ai/static/social-card.png" />
    <meta name="twitter:image:alt" content={page.title} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[#090b0f] text-[#eeece5]">
    <header class="topbar border-b border-white/10">
      <div class={`${sectionShell} topbar-inner flex items-center justify-between gap-5 py-4`}>
        <a class="brand inline-flex min-w-0 items-center border-0 hover:opacity-90" href="#top" aria-label="GORMES-AGENT">
          <img
            class="h-auto w-[168px] max-w-[44vw] sm:w-[220px]"
            src="/static/gormes-agent-logo-blue.svg"
            alt=""
            aria-hidden="true"
          />
        </a>
        <nav class="topnav flex flex-wrap justify-end gap-4 text-xs font-bold uppercase text-[#eeece5]/65" aria-label="Primary">
          {page.nav.map((link) => (
            <a class="border-0 hover:text-[#eeece5]" href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <section id="top" class="hero relative isolate overflow-hidden border-b border-white/10">
        <img
          class="pointer-events-none absolute right-[-62px] top-8 z-0 hidden w-[360px] opacity-30 sm:block md:right-[-36px] md:w-[430px] lg:right-8 lg:opacity-40"
          src="/static/go-gopher-bear-lowpoly.png"
          alt=""
          aria-hidden="true"
        />
        <div class={`${sectionShell} hero-inner relative z-10 py-20 sm:py-24`}>
          <div class="hero-content max-w-3xl">
            <img
              class="hero-logo mb-8 block w-full max-w-[720px]"
              src="/static/gormes-agent-logo-blue.svg"
              alt="GORMES-AGENT"
            />
            <p class="kicker mb-4 text-xs font-bold uppercase text-[#eeece5]/50">{page.heroKicker}</p>
            <h1 class="hero-title mb-6 max-w-[740px] break-words font-serif text-[clamp(2.25rem,8vw,4.75rem)] font-black leading-[0.98] text-white">
              <span class="hero-prompt align-[0.14em] font-mono text-[0.48em] font-bold text-[#f0c84b]" aria-hidden="true">$</span>
              {page.heroHeadline}
            </h1>
            <div class="hero-subhead max-w-2xl space-y-1 text-base leading-7 text-[#eeece5]/75 sm:text-lg">
              {page.heroLines.map((line) => <p>{line}</p>)}
            </div>
            <div class="hero-note mt-7 max-w-2xl border-l-2 border-[#f0c84b] pl-4">
              <p class="hero-note-stamp text-sm font-bold text-[#f0c84b]">{page.heroFilterStamp}</p>
              <p class="hero-note-body mt-1 text-sm leading-6 text-[#eeece5]/70">{page.heroFilterLine}</p>
            </div>
            <div class="hero-ctas mt-8 flex flex-col gap-3 sm:flex-row">
              <a class={buttonPrimary} href={page.primaryCta.href}>{page.primaryCta.label}</a>
              <a class={buttonSecondary} href={page.secondaryCta.href}>{page.secondaryCta.label}</a>
            </div>
            <div class="proof-strip mt-7 flex flex-wrap gap-2">
              {page.proofStrip.map((item) => (
                <span class="proof-item rounded-full border border-white/10 bg-white/[0.035] px-3 py-1 text-xs font-bold text-[#eeece5]/75">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="install" class={`install border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} install-inner`}>
          <div class="install-header max-w-2xl">
            <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">INSTALL</p>
            <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.installHeadline}</h2>
            <p class="install-intro text-base leading-7 text-[#eeece5]/70">{page.installIntro}</p>
          </div>
          <div class="install-grid mt-8 grid gap-4 lg:grid-cols-3">
            {page.installSteps.map((step) => (
              <article class={`${cardShell} install-step flex min-w-0 flex-col gap-4`}>
                <div class="flex items-center justify-between gap-3">
                  <h3 class="font-mono text-xs font-bold uppercase text-[#f0c84b]">{step.label}</h3>
                  <button
                    class="copy-btn inline-flex min-h-8 items-center rounded-md border border-white/15 px-3 py-1.5 font-mono text-xs font-bold text-[#eeece5]/70 transition hover:border-[#f0c84b]/70 hover:text-[#f0c84b]"
                    type="button"
                    data-copy-command
                    aria-label={`Copy ${step.label} command`}
                  >
                    <span class="copy-label">Copy</span>
                  </button>
                </div>
                <pre class="cmd min-w-0 overflow-x-auto rounded-md bg-[#05070a] p-4 text-sm leading-6 text-[#eeece5]"><code>{step.command}</code></pre>
              </article>
            ))}
          </div>
          <p class="install-footnote mt-6 text-sm text-[#eeece5]/65">
            {page.installFootnote}
            <a class="ml-1 font-bold text-[#f0c84b] hover:text-[#ffd968]" href={page.installFootnoteLink.href}>
              {page.installFootnoteLink.label}
            </a>
          </p>
        </div>
      </section>

      <section id="built-for" class={`built-for border-b border-white/10 ${sectionPad}`}>
        <div class={`${sectionShell} built-for-inner`}>
          <h2 class="section-title mb-6 text-2xl font-bold text-[#eeece5]">{page.builtForHeadline}</h2>
          <ul class="built-for-list grid gap-3 sm:grid-cols-2">
            {page.builtForItems.map((item) => (
              <li class="rounded-lg border border-white/10 bg-white/[0.03] p-4 text-sm leading-6 text-[#eeece5]/75">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="why" class={`why border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} why-inner`}>
          <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">{page.whyLabel}</p>
          <h2 class="section-title mb-5 max-w-2xl text-2xl font-bold text-[#eeece5]">{page.whyPainHeadline}</h2>
          <div class="pain-block max-w-3xl">
            <p class="text-base text-[#eeece5]/70">{page.whyPainIntro}</p>
            <ul class="why-pain-list mt-5 grid gap-3 sm:grid-cols-2">
              {page.whyPainBullets.map((item) => (
                <li class="border-l-2 border-[#df6f67] pl-4 text-sm leading-6 text-[#eeece5]/75">{item}</li>
              ))}
            </ul>
          </div>
          <h3 class="why-fix-subhead mt-10 text-lg font-bold text-[#f0c84b]">{page.whyFixSubhead}</h3>
          <div class="features-grid mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {page.featureCards.map((card) => (
              <article class={`${cardShell} feature-card min-w-0`}>
                <h3 class="text-base font-bold text-[#eeece5]">{card.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[#eeece5]/70">{card.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="roadmap" class={`roadmap border-b border-white/10 ${sectionPad}`}>
        <div class={`${sectionShell} roadmap-inner`}>
          <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">{page.roadmapLabel}</p>
          <h2 class="section-title mb-6 text-2xl font-bold text-[#eeece5]">{page.roadmapHeadline}</h2>

          <div class="roadmap-summary grid gap-4 md:grid-cols-[1.4fr_1fr]">
            <div class={`${cardShell} roadmap-summary-block`}>
              <h4 class="roadmap-summary-heading text-sm font-bold text-[#f0c84b]">Current focus</h4>
              <ul class="roadmap-summary-list mt-4 space-y-3 text-sm leading-6 text-[#eeece5]/70">
                {page.roadmapCurrentFocus.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class={`${cardShell} roadmap-summary-block`}>
              <h4 class="roadmap-summary-heading text-sm font-bold text-[#f0c84b]">Next milestone</h4>
              <p class="roadmap-summary-milestone mt-4 text-sm leading-6 text-[#eeece5]/70">
                {page.roadmapNextMilestone}
              </p>
            </div>
          </div>

          <details class="roadmap-details mt-6 rounded-lg border border-white/10 bg-[#10141b]">
            <summary class="roadmap-details-summary cursor-pointer px-5 py-4 text-sm font-bold text-[#eeece5] hover:text-[#f0c84b]">
              {page.roadmapDetailsSummary}
            </summary>
            <div class="roadmap-phases grid gap-4 border-t border-white/10 p-4">
              {roadmapPhases.map((phase) => (
                <article class="roadmap-phase rounded-lg border border-white/10 bg-white/[0.025] p-4">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <h3 class="roadmap-label min-w-0 break-words text-base font-bold text-[#eeece5]">{phase.title}</h3>
                    <span class={`shrink-0 rounded-full border px-3 py-1 text-xs font-bold ${statusClasses[phase.statusTone]}`}>
                      {phase.statusLabel}
                    </span>
                  </div>
                  <div class="mt-4 grid gap-2">
                    {phase.items.map((item) => (
                      <div class="roadmap-item grid grid-cols-[auto_1fr] gap-3 rounded-md border border-white/10 bg-[#090b0f]/55 p-3">
                        <span class={`rounded-full border px-2 py-0.5 text-[11px] font-bold ${statusClasses[item.tone]}`}>
                          {item.statusLabel}
                        </span>
                        <span class="roadmap-label min-w-0 break-words text-sm leading-6 text-[#eeece5]/70">{item.label}</span>
                      </div>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </details>

          <p class="roadmap-footer mt-5 text-sm font-bold text-[#f0c84b]">
            <a class="hover:text-[#ffd968]" href={page.progressTrackerUrl}>
              {trackerLabel} · Full progress tracker →
            </a>
          </p>
        </div>
      </section>

      <section id="explore" class={`explore border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} explore-inner`}>
          <h2 class="section-title mb-6 text-2xl font-bold text-[#eeece5]">{page.exploreHeadline}</h2>
          <div class="explore-grid grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {page.exploreLinks.map((link) => (
              <a class="explore-card rounded-lg border border-white/10 bg-white/[0.035] p-4 text-sm font-bold text-[#eeece5]/75 hover:border-[#f0c84b]/70 hover:text-[#f0c84b]" href={link.href}>
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="final-cta" class={`final-cta ${sectionPad}`}>
        <div class={`${sectionShell} final-cta-inner`}>
          <h2 class="section-title max-w-2xl text-3xl font-bold text-white">{page.finalCtaHeadline}</h2>
          <p class="final-cta-body mt-4 max-w-2xl text-base leading-7 text-[#eeece5]/70">{page.finalCtaBody}</p>
          <div class="final-cta-actions mt-7 flex flex-col gap-3 sm:flex-row">
            <a class={buttonPrimary} href={page.finalPrimaryCta.href}>{page.finalPrimaryCta.label}</a>
            <a class={buttonSecondary} href={page.finalSecondaryCta.href}>{page.finalSecondaryCta.label}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer border-t border-white/10 bg-[#05070a]">
      <div class={`${sectionShell} footer-inner py-8`}>
        <nav class="footer-nav flex flex-wrap gap-3 text-sm font-bold text-[#eeece5]/65" aria-label="Secondary">
          {page.footerNav.map((link) => <a class="hover:text-[#f0c84b]" href={link.href}>{link.label}</a>)}
        </nav>
        <div class="footer-meta mt-4 flex flex-col gap-2 text-sm text-[#eeece5]/55 sm:flex-row sm:items-center sm:justify-between">
          <p class="footer-left">
            Gormes 0.1.0 · <a class="hover:text-[#f0c84b]" href="https://trebuchetdynamics.com/">TrebuchetDynamics</a>
          </p>
          <p class="footer-right">MIT License · 2026</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const button = target.closest('[data-copy-command]');
        if (!button) {
          return;
        }

        const step = button.closest('.install-step');
        const code = step?.querySelector('code')?.innerText || '';
        const label = button.querySelector('.copy-label');
        const original = label?.textContent || 'Copy';

        try {
          await navigator.clipboard.writeText(code);
          if (label) {
            label.textContent = 'Copied';
          }
          button.classList.add('copied');
          setTimeout(() => {
            if (label) {
              label.textContent = original;
            }
            button.classList.remove('copied');
          }, 1500);
        } catch {
          if (label) {
            label.textContent = 'Copy failed';
            setTimeout(() => {
              label.textContent = original;
            }, 1500);
          }
        }
      });
    </script>
  </body>
</html>
