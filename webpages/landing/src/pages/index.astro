---
import BaseDocument from '../components/BaseDocument.astro';
import { page } from '../data/landing.js';

const sectionShell = 'mx-auto max-w-5xl px-5 sm:px-7';
const sectionPad = 'py-14 sm:py-16';
const cardShell = 'rounded-lg border border-white/10 bg-white/[0.035] p-5 shadow-[0_1px_0_rgba(255,255,255,0.04)_inset]';
const buttonBase = 'btn inline-flex min-h-11 items-center justify-center rounded-md px-4 py-2 text-sm font-bold transition hover:border-transparent focus-visible:rounded-md';
const buttonPrimary = `${buttonBase} btn-primary bg-[#f0c84b] text-[#171000] hover:bg-[#ffd968]`;
const buttonSecondary = `${buttonBase} btn-secondary border border-white/15 bg-white/[0.035] text-[#eeece5] hover:border-[#f0c84b]/70 hover:text-[#f0c84b]`;
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Gormes',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows, Android/Termux',
  url: page.siteUrl,
  description: page.description,
  softwareVersion: page.releaseTag,
  license: 'https://opensource.org/license/mit',
  codeRepository: 'https://github.com/TrebuchetDynamics/gormes-agent',
  downloadUrl: 'https://gormes.ai/install.sh',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'TrebuchetDynamics',
    url: 'https://trebuchetdynamics.com/',
  },
};
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TrebuchetDynamics',
  url: 'https://trebuchetdynamics.com/',
  sameAs: ['https://github.com/TrebuchetDynamics'],
};
---

<BaseDocument
  title={page.title}
  description={page.description}
  canonicalUrl={page.siteUrl}
  keywords="Go AI agent runtime, Hermes agent alternative, single binary AI agent, offline AI agent runtime, AI agent gateway, Termux AI agent"
  socialUrl={page.siteUrl}
  socialImageAlt="Gormes Go-native AI agent runtime without Python or Docker"
  structuredData={[softwareSchema, organizationSchema]}
>
  <link slot="head" rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <header class="topbar border-b border-white/10">
      <div class={`${sectionShell} topbar-inner flex items-center justify-between gap-5 py-4`}>
        <a class="brand inline-flex min-w-0 items-center border-0 hover:opacity-90" href="#top" aria-label="Gormes">
          <img
            class="h-auto w-[168px] max-w-[44vw] sm:w-[220px]"
            src="/static/gormes-agent-logo-blue.svg"
            alt="Gormes"
          />
        </a>
        <nav class="topnav flex flex-wrap justify-end gap-4 text-xs font-bold uppercase text-[#eeece5]/65" aria-label="Primary">
          {page.nav.map((link) => (
            <a class="border-0 hover:text-[#eeece5]" href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <section id="top" class="hero relative isolate overflow-hidden border-b border-white/10">
        <img
          class="pointer-events-none absolute right-[-62px] top-8 z-0 hidden w-[360px] opacity-24 sm:block md:right-[-36px] md:w-[430px] lg:right-8 lg:opacity-35"
          src="/static/go-gopher-bear-lowpoly.png"
          alt="Gormes Go-native AI agent runtime mascot"
        />
        <div class={`${sectionShell} hero-inner relative z-10 py-16 sm:py-20`}>
          <div class="hero-content max-w-3xl">
            <p class="kicker mb-4 text-xs font-bold uppercase tracking-[0.18em] text-[#73cedd]">{page.heroKicker}</p>
            <h1 class="hero-title mb-5 max-w-[780px] break-words font-serif text-[clamp(2.35rem,8vw,4.8rem)] font-black leading-[0.98] text-white">
              {page.heroHeadline}
            </h1>
            <div class="hero-subhead max-w-2xl text-base leading-7 text-[#eeece5]/75 sm:text-lg">
              {page.heroLines.map((line) => <p>{line}</p>)}
            </div>
            <div class="hero-ctas mt-7 flex flex-col gap-3 sm:flex-row">
              <a class={buttonPrimary} href={page.primaryCta.href}>{page.primaryCta.label}</a>
              <a class={buttonSecondary} href={page.secondaryCta.href}>{page.secondaryCta.label}</a>
            </div>
            <div class="proof-strip mt-6 flex flex-wrap gap-2">
              {page.proofStrip.map((item) => (
                <span
                  class={`proof-item rounded-full border px-3 py-1 text-xs font-bold ${
                    item.kind === 'pop'
                      ? 'proof-item-pop border-[#f0c84b]/55 bg-[#f0c84b]/10 text-[#f0c84b]'
                      : 'border-white/10 bg-white/[0.035] text-[#eeece5]/75'
                  }`}
                >
                  {item.label}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="why" class={`why border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} why-inner`}>
          <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">{page.whyLabel}</p>
          <h2 class="section-title mb-5 max-w-2xl text-2xl font-bold text-[#eeece5]">{page.whyPainHeadline}</h2>
          <p class="max-w-3xl text-base leading-7 text-[#eeece5]/70">{page.whyPainIntro}</p>
          <div class="why-card-grid mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {page.whyCards.map((card) => (
              <article class={`${cardShell} why-card min-w-0`}>
                <h3 class="text-base font-bold text-[#eeece5]">{card.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[#eeece5]/70">{card.body}</p>
                {card.href && card.linkLabel && (
                  <a class="mt-4 inline-block text-sm font-bold text-[#f0c84b] hover:text-[#ffd968]" href={card.href}>
                    {card.linkLabel}
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="built-for" class={`built-for border-b border-white/10 ${sectionPad}`}>
        <div class={`${sectionShell} built-for-inner`}>
          <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.worksHeadline}</h2>
          <p class="max-w-2xl text-base leading-7 text-[#eeece5]/70">{page.worksIntro}</p>
          <div class="works-grid mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {page.worksItems.map((item) => (
              <article class="works-card rounded-lg border border-white/10 bg-white/[0.035] p-4 text-sm font-bold text-[#eeece5]/80">
                {item}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="install" class={`install border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} install-inner`}>
          <div class="install-header max-w-2xl">
            <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">INSTALL</p>
            <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.installHeadline}</h2>
            <p class="install-intro text-base leading-7 text-[#eeece5]/70">{page.installIntro}</p>
          </div>
          <article class={`${cardShell} install-step mt-8 flex min-w-0 flex-col gap-4`}>
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-mono text-xs font-bold uppercase text-[#f0c84b]">Linux, macOS, WSL2</h3>
              <button
                class="copy-btn inline-flex min-h-8 items-center rounded-md border border-white/15 px-3 py-1.5 font-mono text-xs font-bold text-[#eeece5]/70 transition hover:border-[#f0c84b]/70 hover:text-[#f0c84b]"
                type="button"
                data-copy-command
                aria-label="Copy install command"
              >
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <pre class="cmd min-w-0 overflow-x-auto rounded-md bg-[#05070a] p-4 text-sm leading-6 text-[#eeece5]"><code>{page.installCommand}</code></pre>
          </article>
          <p class="install-footnote mt-6 text-sm text-[#eeece5]/65">
            {page.installFootnote}
            <a class="ml-1 font-bold text-[#f0c84b] hover:text-[#ffd968]" href={page.installFootnoteLink.href}>
              {page.installFootnoteLink.label}
            </a>
          </p>
        </div>
      </section>

      <section id="proof" class={`proof border-b border-white/10 ${sectionPad}`}>
        <div class={`${sectionShell} proof-inner`}>
          <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.proofHeadline}</h2>
          <p class="max-w-2xl text-base leading-7 text-[#eeece5]/70">{page.proofIntro}</p>
          <div class="proof-grid mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {page.proofItems.map((item) => (
              <article class={`${cardShell} proof-card`}>
                <p class="font-mono text-2xl font-black text-[#73cedd]">{item.value}</p>
                <h3 class="mt-2 text-sm font-bold text-[#eeece5]">{item.label}</h3>
                <p class="mt-2 text-xs leading-5 text-[#eeece5]/65">{item.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="roadmap" class={`roadmap border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} roadmap-inner`}>
          <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">{page.roadmapLabel}</p>
          <h2 class="section-title mb-6 text-2xl font-bold text-[#eeece5]">{page.roadmapHeadline}</h2>
          <div class="roadmap-summary grid gap-4 md:grid-cols-2">
            <article class={`${cardShell} roadmap-summary-block`}>
              <h3 class="roadmap-summary-heading text-sm font-bold text-[#f0c84b]">Available now</h3>
              <ul class="roadmap-summary-list mt-4 space-y-2 text-sm leading-6 text-[#eeece5]/70">
                {page.roadmapNow.map((item) => <li>{item}</li>)}
              </ul>
            </article>
            <article class={`${cardShell} roadmap-summary-block`}>
              <h3 class="roadmap-summary-heading text-sm font-bold text-[#f0c84b]">Expanding next</h3>
              <ul class="roadmap-summary-list mt-4 space-y-2 text-sm leading-6 text-[#eeece5]/70">
                {page.roadmapNext.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          </div>
          <p class="roadmap-footer mt-5 text-sm font-bold text-[#f0c84b]">
            <a class="hover:text-[#ffd968]" href={page.progressTrackerUrl}>
              {page.roadmapLinkLabel}
            </a>
          </p>
        </div>
      </section>

      <section id="final-cta" class={`final-cta ${sectionPad}`}>
        <div class={`${sectionShell} final-cta-inner`}>
          <h2 class="section-title max-w-2xl text-3xl font-bold text-white">{page.finalCtaHeadline}</h2>
          <p class="final-cta-body mt-4 max-w-2xl text-base leading-7 text-[#eeece5]/70">{page.finalCtaBody}</p>
          <div class="final-cta-actions mt-7 flex flex-col gap-3 sm:flex-row">
            <a class={buttonPrimary} href={page.finalPrimaryCta.href}>{page.finalPrimaryCta.label}</a>
            <a class={buttonSecondary} href={page.finalSecondaryCta.href}>{page.finalSecondaryCta.label}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer border-t border-white/10 bg-[#05070a]">
      <div class={`${sectionShell} footer-inner py-8`}>
        <nav class="footer-nav flex flex-wrap gap-3 text-sm font-bold text-[#eeece5]/65" aria-label="Secondary">
          {page.footerNav.map((link) => <a class="hover:text-[#f0c84b]" href={link.href}>{link.label}</a>)}
        </nav>
        <div class="footer-meta mt-4 flex flex-col gap-2 text-sm text-[#eeece5]/55 sm:flex-row sm:items-center sm:justify-between">
          <p class="footer-left">
            {page.footerRelease} · <a class="hover:text-[#f0c84b]" href="https://trebuchetdynamics.com/">TrebuchetDynamics</a>
          </p>
          <p class="footer-right">MIT License · 2026</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const button = target.closest('[data-copy-command]');
        if (!button) {
          return;
        }

        const step = button.closest('.install-step');
        const code = step?.querySelector('code')?.innerText || '';
        const label = button.querySelector('.copy-label');
        const original = label?.textContent || 'Copy';

        try {
          await navigator.clipboard.writeText(code);
          if (label) {
            label.textContent = 'Copied';
          }
          button.classList.add('copied');
          setTimeout(() => {
            if (label) {
              label.textContent = original;
            }
            button.classList.remove('copied');
          }, 1500);
        } catch {
          if (label) {
            label.textContent = 'Copy failed';
            setTimeout(() => {
              label.textContent = original;
            }, 1500);
          }
        }
      });
    </script>
</BaseDocument>
