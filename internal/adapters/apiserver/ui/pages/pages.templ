package pages

import "github.com/TrebuchetDynamics/gormes-agent/internal/adapters/apiserver/ui/shell"

templ Sessions() {
	@shell.Layout("Sessions") {
		<h1>📋 Sessions</h1>
		<div id="session-list" hx-get="/api/sessions" hx-trigger="load" hx-swap="innerHTML">
			<div style="color:var(--dim)">Loading sessions…</div>
		</div>
	}
}

templ Config() {
	@shell.Layout("Config") {
		<h1>⚙️ Configuration</h1>
		<div id="config-view" hx-get="/api/config" hx-trigger="load" hx-swap="innerHTML">
			<div style="color:var(--dim)">Loading configuration…</div>
		</div>
	}
}

templ Skills() {
	@shell.Layout("Skills") {
		<h1>📦 Skills</h1>
		<div id="skills-view" hx-get="/api/skills" hx-trigger="load" hx-swap="innerHTML">
			<div style="color:var(--dim)">Loading skills…</div>
		</div>
	}
}

templ Cron() {
	@shell.Layout("Cron") {
		<h1>⏰ Cron Jobs</h1>
		<div id="cron-list" hx-get="/v1/admin/cron/jobs" hx-trigger="load" hx-swap="innerHTML">
			<div style="color:var(--dim)">Loading cron jobs…</div>
		</div>
	}
}
