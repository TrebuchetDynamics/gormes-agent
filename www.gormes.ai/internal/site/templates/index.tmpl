{{define "index"}}
<section id="top" class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <p class="kicker">{{.HeroKicker}}</p>
      <h1 class="hero-title"><span class="hero-prompt" aria-hidden="true">$</span> {{.HeroHeadline}}</h1>
      <div class="hero-subhead">
        {{range .HeroLines}}<p>{{.}}</p>{{end}}
      </div>
      <div class="hero-note">
        <p class="hero-note-stamp">{{.HeroFilterStamp}}</p>
        <p class="hero-note-body">{{.HeroFilterLine}}</p>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="{{.PrimaryCTA.Href}}">{{.PrimaryCTA.Label}}</a>
        <a class="btn btn-secondary" href="{{.SecondaryCTA.Href}}">{{.SecondaryCTA.Label}}</a>
      </div>
      {{if .ProofStrip}}
      <div class="proof-strip">
        {{range .ProofStrip}}<span class="proof-item">{{.}}</span>{{end}}
      </div>
      {{end}}
    </div>
  </div>
</section>

<section id="install" class="install">
  <div class="install-inner">
    <div class="install-header">
      <p class="kicker">INSTALL</p>
      <h2 class="section-title">Install in one command. Verify everything works.</h2>
      <p class="install-intro">{{.InstallIntro}}</p>
    </div>
    <div class="install-grid">
      {{range .InstallSteps}}{{template "install_step" .}}{{end}}
    </div>
    <p class="install-footnote">{{.InstallFootnote}} <a href="{{.InstallFootnoteHref}}">{{.InstallFootnoteLink}}</a></p>
  </div>
</section>

{{if .DemoCommand}}
<section id="demo" class="demo">
  <div class="demo-inner">
    <h2 class="section-title">{{.DemoHeadline}}</h2>
    <p class="demo-intro">{{.DemoIntro}}</p>
    <div class="demo-terminal">
      <pre class="cmd"><code>{{.DemoCommand}}</code></pre>
    </div>
    <a class="btn btn-secondary" href="{{.DemoCTA.Href}}">{{.DemoCTA.Label}}</a>
  </div>
</section>
{{end}}

<section id="why" class="why">
  <div class="why-inner">
    <p class="kicker">{{.WhyLabel}}</p>
    <h2 class="section-title">{{.WhyPainHeadline}}</h2>
    <div class="pain-block">
      <p>{{.WhyPainIntro}}</p>
      <ul class="why-pain-list">
        {{range .WhyPainBullets}}<li>{{.}}</li>{{end}}
      </ul>
    </div>
    <h3 class="why-fix-subhead">{{.WhyFixSubhead}}</h3>
    <div class="features-grid">
      {{range .FeatureCards}}{{template "feature_card" .}}{{end}}
    </div>
  </div>
</section>

{{if .BuiltForItems}}
<section id="built-for" class="built-for">
  <div class="built-for-inner">
    <h2 class="section-title">{{.BuiltForHeadline}}</h2>
    <ul class="built-for-list">
      {{range .BuiltForItems}}<li>{{.}}</li>{{end}}
    </ul>
  </div>
</section>
{{end}}

<section id="roadmap" class="roadmap">
  <div class="roadmap-inner">
    <p class="kicker">{{.RoadmapLabel}}</p>
    <h2 class="section-title">{{.RoadmapHeadline}}</h2>

    <div class="roadmap-summary">
      <div class="roadmap-summary-block">
        <h4 class="roadmap-summary-heading">Current focus</h4>
        <ul class="roadmap-summary-list">
          {{range .RoadmapCurrentFocus}}<li>{{.}}</li>{{end}}
        </ul>
      </div>
      <div class="roadmap-summary-block">
        <h4 class="roadmap-summary-heading">Next milestone</h4>
        <p class="roadmap-summary-milestone">{{.RoadmapNextMilestone}}</p>
      </div>
    </div>

    <details class="roadmap-details">
      <summary class="roadmap-details-summary">{{.RoadmapDetailsSummary}}</summary>
      <div class="roadmap-phases">
        {{range .RoadmapPhases}}{{template "roadmap_phase" .}}{{end}}
      </div>
    </details>

    <p class="roadmap-footer">
      <a href="{{.ProgressTrackerURL}}">{{.ProgressTracker}} · Full progress tracker →</a>
    </p>
  </div>
</section>

{{if .ExploreLinks}}
<section id="explore" class="explore">
  <div class="explore-inner">
    <h2 class="section-title">{{.ExploreHeadline}}</h2>
    <div class="explore-grid">
      {{range .ExploreLinks}}<a class="explore-card" href="{{.Href}}">{{.Label}}</a>{{end}}
    </div>
  </div>
</section>
{{end}}

{{if .FinalCTAHeadline}}
<section id="final-cta" class="final-cta">
  <div class="final-cta-inner">
    <h2 class="section-title">{{.FinalCTAHeadline}}</h2>
    <p class="final-cta-body">{{.FinalCTABody}}</p>
    <div class="final-cta-actions">
      <a class="btn btn-primary" href="{{.FinalPrimaryCTA.Href}}">{{.FinalPrimaryCTA.Label}}</a>
      <a class="btn btn-secondary" href="{{.FinalSecondaryCTA.Href}}">{{.FinalSecondaryCTA.Label}}</a>
    </div>
  </div>
</section>
{{end}}
{{end}}
