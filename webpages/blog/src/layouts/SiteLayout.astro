---
import {
  absoluteUrl,
  feedPath,
  githubUrl,
  siteDescription,
  siteTitle,
  socialImagePath,
} from '../lib/site.js';
import '../styles/global.css';

const {
  title = siteTitle,
  description = siteDescription,
  image = socialImagePath,
  type = 'website',
} = Astro.props;

const canonicalUrl = absoluteUrl(Astro.url.pathname);
const feedUrl = absoluteUrl(feedPath);
const imageUrl = absoluteUrl(image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={feedUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="TrebuchetDynamics Engineering home">
        <img src="/static/gormes-agent-logo-blue.svg" width="116" height="36" alt="GORMES-AGENT" />
        <span>TrebuchetDynamics Engineering</span>
      </a>
      <nav aria-label="Primary">
        <a href="/">Posts</a>
        <a href="/about/">About</a>
        <a href="/feed.xml">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Validation-gated agentic engineering, published from markdown.</span>
      <a href={githubUrl}>gormes-agent</a>
    </footer>
  </body>
</html>
