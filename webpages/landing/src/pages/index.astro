---
import BaseDocument from '../components/BaseDocument.astro';
import { page } from '../data/landing.js';
import { site } from '../data/site.js';

const sectionShell = 'mx-auto max-w-6xl px-5 sm:px-7 lg:px-8';
const sectionPad = 'py-14 sm:py-18 lg:py-20';
const cardShell = 'glass-card rounded-2xl border border-white/10 bg-white/[0.045] p-5 shadow-[0_18px_60px_rgba(0,0,0,0.22)]';
const buttonBase = 'btn inline-flex min-h-11 items-center justify-center rounded-full px-5 py-2.5 text-sm font-bold transition hover:border-transparent focus-visible:rounded-full';
const buttonPrimary = `${buttonBase} btn-primary bg-[#f0c84b] text-[#171000] shadow-[0_12px_34px_rgba(240,200,75,0.24)] hover:bg-[#ffd968]`;
const buttonSecondary = `${buttonBase} btn-secondary border border-white/15 bg-white/[0.055] text-[#eeece5] hover:border-[#f0c84b]/70 hover:text-[#f0c84b]`;
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Gormes',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows, Android/Termux',
  url: page.siteUrl,
  description: page.description,
  softwareVersion: page.releaseTag,
  license: 'https://opensource.org/license/mit',
  codeRepository: site.githubUrl,
  downloadUrl: site.installScriptUrl,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: site.publisherName,
    url: site.publisherUrl,
  },
};
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.publisherName,
  url: site.publisherUrl,
  sameAs: ['https://github.com/TrebuchetDynamics'],
};
---

<BaseDocument
  title={page.title}
  description={page.description}
  canonicalUrl={page.siteUrl}
  keywords="Go AI agent runtime, local AI agent runtime, single binary AI agent, offline AI runtime, AI agent memory, AI gateway runtime, Hermes agent alternative, Android Termux AI agent"
  socialUrl={page.siteUrl}
  socialImageAlt="Gormes Go-native AI agent runtime without Python or Docker"
  structuredData={[softwareSchema, organizationSchema]}
>
  <link slot="head" rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar sticky top-0 z-50 border-b border-white/10 bg-[#090b0f]/78 backdrop-blur-xl supports-[backdrop-filter]:bg-[#090b0f]/64">
      <div class={`${sectionShell} topbar-inner flex items-center justify-between gap-5 py-4`}>
        <a class="brand inline-flex min-w-0 items-center border-0 hover:opacity-90" href="#top" aria-label="Gormes">
          <img
            class="h-auto w-[168px] max-w-[44vw] sm:w-[220px]"
            src="/static/gormes-agent-logo-blue.svg"
            alt="Gormes"
            width="1200"
            height="150"
          />
        </a>
        <nav aria-label="Primary">
          <ul class="topnav m-0 flex list-none flex-wrap justify-end gap-2 p-0 text-xs font-bold uppercase text-[#eeece5]/65 sm:gap-3" role="list">
            {page.nav.map((link) => (
              <li>
                <a class="rounded-full border border-transparent px-2.5 py-1.5 hover:border-white/10 hover:bg-white/[0.055] hover:text-[#eeece5]" href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <section id="top" class="hero relative isolate overflow-hidden border-b border-white/10">
        <img
          class="pointer-events-none absolute right-[-62px] top-10 z-0 hidden h-auto w-[360px] opacity-[0.18] sm:block md:right-[-36px] md:w-[430px] lg:right-8 lg:opacity-[0.28]"
          src="/static/go-gopher-bear-lowpoly.png"
          alt="Gormes Go-native AI agent runtime mascot"
          width="800"
          height="800"
          fetchpriority="low"
          decoding="async"
        />
        <div class={`${sectionShell} hero-inner relative z-10 grid gap-10 py-16 sm:py-20 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,0.72fr)] lg:items-center lg:py-24`}>
          <div class="hero-content min-w-0 max-w-3xl">
            <p class="kicker mb-4 text-xs font-bold uppercase tracking-[0.2em] text-[#73cedd]">{page.heroKicker}</p>
            <h1 class="hero-title mb-5 max-w-[820px] text-balance font-serif text-[clamp(2.45rem,7.8vw,5.35rem)] font-black leading-[0.95] tracking-[-0.045em] text-white">
              {page.heroHeadline}
            </h1>
            <div class="hero-subhead max-w-2xl text-pretty text-base leading-7 text-[#eeece5]/[0.76] sm:text-lg">
              {page.heroLines.map((line) => <p>{line}</p>)}
            </div>
            <div class="hero-ctas mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a class={buttonPrimary} href={page.primaryCta.href}>{page.primaryCta.label}</a>
              <a class={buttonSecondary} href={page.secondaryCta.href}>{page.secondaryCta.label}</a>
              <a class="inline-flex min-h-11 items-center justify-center rounded-full px-2 py-2 text-sm font-bold text-[#f0c84b] hover:text-[#ffd968] sm:justify-start" href={page.tertiaryCta.href}>{page.tertiaryCta.label}</a>
            </div>
            <div class="proof-strip mt-6 flex flex-wrap gap-2">
              {page.proofStrip.map((item) => (
                <span
                  class={`proof-item rounded-full border px-3 py-1 text-xs font-bold ${
                    item.kind === 'pop'
                      ? 'proof-item-pop border-[#f0c84b]/55 bg-[#f0c84b]/10 text-[#f0c84b]'
                      : 'border-white/10 bg-white/[0.035] text-[#eeece5]/75'
                  }`}
                >
                  {item.label}
                </span>
              ))}
            </div>
            <p class="hero-status mt-5 max-w-2xl rounded-2xl border border-[#73cedd]/20 bg-[#73cedd]/[0.08] px-4 py-3 text-sm leading-6 text-[#d7f7ff]/[0.78]">
              {page.heroStatus}
            </p>
          </div>

          <aside class="hero-panel glass-card min-w-0 rounded-3xl border border-white/[0.12] bg-[#0f1622]/[0.72] p-5 shadow-[0_30px_120px_rgba(0,0,0,0.34)] backdrop-blur-xl sm:p-6" aria-label="Gormes operator quick path">
            <p class="kicker text-xs font-bold uppercase tracking-[0.18em] text-[#73cedd]">{page.heroPanelEyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold leading-tight text-white">{page.heroPanelTitle}</h2>
            <ol class="mt-5 space-y-3" aria-label="Quick start commands">
              {page.heroPanelSteps.map((step, index) => (
                <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] items-start gap-3 rounded-2xl border border-white/[0.08] bg-black/20 p-3">
                  <span class="rounded-full bg-[#f0c84b]/12 px-2 py-1 text-center font-mono text-xs font-bold text-[#f0c84b]">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <code class="break-words font-mono text-sm leading-6 text-[#eeece5]/85">{step.command}</code>
                    <p class="mt-1 text-xs leading-5 text-[#eeece5]/55">{step.note}</p>
                  </div>
                </li>
              ))}
            </ol>
            <dl class="hero-panel-metrics mt-5 grid gap-2 sm:grid-cols-3">
              {page.heroMetrics.map((item) => (
                <div class="rounded-2xl border border-white/[0.08] bg-white/[0.035] p-3">
                  <dt class="text-xs font-bold uppercase tracking-[0.08em] text-[#eeece5]/[0.52]">{item.label}</dt>
                  <dd class="mt-1 font-mono text-lg font-black text-[#73cedd]">{item.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        </div>
      </section>

      <section id="why" class={`why border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} why-inner`}>
          <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">{page.whyLabel}</p>
          <h2 class="section-title mb-5 max-w-2xl text-2xl font-bold text-[#eeece5]">{page.whyPainHeadline}</h2>
          <p class="max-w-3xl text-base leading-7 text-[#eeece5]/70">{page.whyPainIntro}</p>
          <div class="why-card-grid mt-8 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
            {page.whyCards.map((card) => (
              <article class={`${cardShell} why-card min-w-0 transition duration-200 hover:-translate-y-0.5 hover:border-[#73cedd]/28 hover:bg-white/[0.065]`}>
                <h3 class="text-base font-bold text-[#eeece5]">{card.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[#eeece5]/70">{card.body}</p>
                {card.href && card.linkLabel && (
                  <a class="mt-4 inline-block text-sm font-bold text-[#f0c84b] hover:text-[#ffd968]" href={card.href}>
                    {card.linkLabel}
                  </a>
                )}
              </article>
            ))}
          </div>
          <aside class="mt-8 rounded-3xl border border-[#73cedd]/20 bg-[#73cedd]/[0.055] p-5 sm:p-6" aria-labelledby="saas-heading">
            <h3 id="saas-heading" class="text-xl font-bold text-[#eeece5]">{page.saasHeadline}</h3>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-[#eeece5]/70">{page.saasIntro}</p>
            <ul class="mt-5 grid grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-2 text-sm font-bold text-[#d7f7ff]/80" role="list">
              {page.saasItems.map((item) => (
                <li class="rounded-full border border-white/[0.08] bg-black/15 px-3 py-2">{item}</li>
              ))}
            </ul>
          </aside>
        </div>
      </section>

      <section id="built-for" class={`built-for border-b border-white/10 ${sectionPad}`}>
        <div class={`${sectionShell} built-for-inner`}>
          <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.worksHeadline}</h2>
          <p class="max-w-2xl text-base leading-7 text-[#eeece5]/70">{page.worksIntro}</p>
          <p class="mt-4 max-w-3xl rounded-2xl border border-white/[0.08] bg-white/[0.035] px-4 py-3 text-sm leading-6 text-[#eeece5]/72">
            {page.localRemoteCopy}
          </p>
          <div class="works-grid mt-8 grid grid-cols-[repeat(auto-fit,minmax(165px,1fr))] gap-3">
            {page.worksItems.map((item) => (
              <article class="works-card rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-sm font-bold text-[#eeece5]/80 shadow-[0_1px_0_rgba(255,255,255,0.04)_inset]">
                {item}
              </article>
            ))}
          </div>
          <div class="mt-8 grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
            <article class={`${cardShell} min-w-0`}>
              <h3 class="text-lg font-bold text-[#eeece5]">Where can Gormes run?</h3>
              <ul class="mt-4 flex flex-wrap gap-2 text-sm font-bold text-[#eeece5]/75" role="list">
                {page.runTargets.map((target) => (
                  <li class="rounded-full border border-white/10 bg-white/[0.035] px-3 py-1.5">{target}</li>
                ))}
              </ul>
              <p class="mt-5 text-sm leading-6 text-[#eeece5]/65">{page.navivoxCopy}</p>
            </article>
            <article class={`${cardShell} min-w-0`}>
              <h3 class="text-lg font-bold text-[#eeece5]">First useful workflows</h3>
              <ul class="mt-4 grid gap-2 text-sm leading-6 text-[#eeece5]/75 sm:grid-cols-2" role="list">
                {page.workflowExamples.map((item) => (
                  <li class="rounded-2xl border border-white/[0.08] bg-black/15 px-3 py-2">{item}</li>
                ))}
              </ul>
            </article>
          </div>
          <div class="mt-8">
            <div class="mb-4 max-w-2xl">
              <h3 class="text-lg font-bold text-[#eeece5]">{page.runtimeVisualHeadline}</h3>
              <p class="mt-2 text-sm leading-6 text-[#eeece5]/65">{page.runtimeVisualIntro}</p>
            </div>
            <div class="grid gap-4">
              {page.runtimeVisuals.map((visual) => (
                <figure class={`${cardShell} overflow-hidden p-0`}>
                  <img
                    class="h-auto w-full rounded-t-2xl border-b border-white/10 bg-[#05070a]"
                    src={visual.image}
                    alt={visual.alt}
                    width={visual.width}
                    height={visual.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="p-5">
                    <h4 class="text-base font-bold text-[#eeece5]">{visual.title}</h4>
                    <p class="mt-2 text-sm leading-6 text-[#eeece5]/65">{visual.body}</p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="install" class={`install border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} install-inner`}>
          <div class="install-header max-w-2xl">
            <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">INSTALL</p>
            <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.installHeadline}</h2>
            <p class="install-intro text-base leading-7 text-[#eeece5]/70">{page.installIntro}</p>
          </div>
          <figure class={`${cardShell} install-step mt-8 flex min-w-0 flex-col gap-4`}>
            <figcaption class="flex flex-wrap items-center justify-between gap-3">
              <span class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-[#f0c84b]">Linux, macOS, WSL2</span>
              <button
                class="copy-btn inline-flex min-h-8 items-center rounded-full border border-white/15 px-3 py-1.5 font-mono text-xs font-bold text-[#eeece5]/70 transition hover:border-[#f0c84b]/70 hover:text-[#f0c84b]"
                type="button"
                data-copy-command
                aria-label="Copy install command"
              >
                <span class="copy-label">Copy</span>
              </button>
            </figcaption>
            <pre class="cmd min-w-0 overflow-x-auto rounded-xl bg-[#05070a] p-4 text-sm leading-6 text-[#eeece5]" tabindex="0"><code>{page.installCommand}</code></pre>
          </figure>
          <p class="install-footnote mt-6 text-sm text-[#eeece5]/65">
            {page.installFootnote}
            <a class="ml-1 font-bold text-[#f0c84b] hover:text-[#ffd968]" href={page.installFootnoteLink.href}>
              {page.installFootnoteLink.label}
            </a>
          </p>
        </div>
      </section>

      <section id="proof" class={`proof border-b border-white/10 ${sectionPad}`}>
        <div class={`${sectionShell} proof-inner`}>
          <h2 class="section-title mb-4 text-2xl font-bold text-[#eeece5]">{page.proofHeadline}</h2>
          <p class="max-w-2xl text-base leading-7 text-[#eeece5]/70">{page.proofIntro}</p>
          <div class="proof-grid mt-8 grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-4">
            {page.proofItems.map((item) => (
              <article class={`${cardShell} proof-card`}>
                <p class="font-mono text-2xl font-black text-[#73cedd]">{item.value}</p>
                <h3 class="mt-2 text-sm font-bold text-[#eeece5]">{item.label}</h3>
                <p class="mt-2 text-xs leading-5 text-[#eeece5]/65">{item.detail}</p>
              </article>
            ))}
          </div>
          <nav class="mt-6 flex flex-wrap gap-2" aria-label="Trust evidence">
            {page.proofLinks.map((link) => (
              <a class="rounded-full border border-white/10 bg-white/[0.035] px-3 py-2 text-sm font-bold text-[#f0c84b] hover:border-[#f0c84b]/60 hover:text-[#ffd968]" href={link.href}>{link.label}</a>
            ))}
          </nav>
        </div>
      </section>

      <section id="roadmap" class={`roadmap border-b border-white/10 bg-[#10141b] ${sectionPad}`}>
        <div class={`${sectionShell} roadmap-inner`}>
          <p class="kicker mb-3 text-xs font-bold uppercase text-[#eeece5]/50">{page.roadmapLabel}</p>
          <h2 class="section-title mb-6 text-2xl font-bold text-[#eeece5]">{page.roadmapHeadline}</h2>
          <div class="roadmap-summary grid gap-4 md:grid-cols-2">
            <article class={`${cardShell} roadmap-summary-block`}>
              <h3 class="roadmap-summary-heading text-sm font-bold text-[#f0c84b]">Available now</h3>
              <ul class="roadmap-summary-list mt-4 space-y-2 text-sm leading-6 text-[#eeece5]/70">
                {page.roadmapNow.map((item) => <li>{item}</li>)}
              </ul>
            </article>
            <article class={`${cardShell} roadmap-summary-block`}>
              <h3 class="roadmap-summary-heading text-sm font-bold text-[#f0c84b]">Expanding next</h3>
              <ul class="roadmap-summary-list mt-4 space-y-2 text-sm leading-6 text-[#eeece5]/70">
                {page.roadmapNext.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          </div>
          <p class="roadmap-footer mt-5 text-sm font-bold text-[#f0c84b]">
            <a class="hover:text-[#ffd968]" href={page.progressTrackerUrl}>
              {page.roadmapLinkLabel}
            </a>
          </p>
        </div>
      </section>

      <section id="final-cta" class={`final-cta ${sectionPad}`}>
        <div class={`${sectionShell} final-cta-inner`}>
          <h2 class="section-title max-w-2xl text-3xl font-bold text-white">{page.finalCtaHeadline}</h2>
          <p class="final-cta-body mt-4 max-w-2xl text-base leading-7 text-[#eeece5]/70">{page.finalCtaBody}</p>
          <div class="final-cta-actions mt-7 flex flex-col gap-3 sm:flex-row">
            <a class={buttonPrimary} href={page.finalPrimaryCta.href}>{page.finalPrimaryCta.label}</a>
            <a class={buttonSecondary} href={page.finalSecondaryCta.href}>{page.finalSecondaryCta.label}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer border-t border-white/10 bg-[#05070a]">
      <div class={`${sectionShell} footer-inner py-8`}>
        <nav class="footer-nav flex flex-wrap gap-3 text-sm font-bold text-[#eeece5]/65" aria-label="Secondary">
          {page.footerNav.map((link) => <a class="hover:text-[#f0c84b]" href={link.href}>{link.label}</a>)}
        </nav>
        <div class="footer-meta mt-4 flex flex-col gap-2 text-sm text-[#eeece5]/55 sm:flex-row sm:items-center sm:justify-between">
          <p class="footer-left">
            {page.footerRelease} · <a class="hover:text-[#f0c84b]" href="https://trebuchetdynamics.com/">TrebuchetDynamics</a>
          </p>
          <p class="footer-right">MIT License · 2026</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const button = target.closest('[data-copy-command]');
        if (!button) {
          return;
        }

        const step = button.closest('.install-step');
        const code = step?.querySelector('code')?.innerText || '';
        const label = button.querySelector('.copy-label');
        const original = label?.textContent || 'Copy';

        try {
          await navigator.clipboard.writeText(code);
          if (label) {
            label.textContent = 'Copied';
          }
          button.classList.add('copied');
          setTimeout(() => {
            if (label) {
              label.textContent = original;
            }
            button.classList.remove('copied');
          }, 1500);
        } catch {
          if (label) {
            label.textContent = 'Copy failed';
            setTimeout(() => {
              label.textContent = original;
            }, 1500);
          }
        }
      });
    </script>
</BaseDocument>
