package shell

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width,initial-scale=1"/>
		<title>{ title } — Gormes</title>
		<style>
			:root{--bg:#041c1c;--fg:#ffe6cb;--accent:#FFD700;--muted:#B8860B;--border:#CD7F32;--card:color-mix(in srgb,#ffe6cb 4%,#041c1c);--ok:#4caf50;--err:#ef5350;--warn:#ffa726;--dim:#8B8682}
			*{margin:0;padding:0;box-sizing:border-box}
			body{font-family:system-ui,monospace;background:var(--bg);color:var(--fg);display:flex;height:100vh;overflow:hidden;text-transform:uppercase;font-size:13px;letter-spacing:.5px}
			nav{width:200px;border-right:1px solid var(--border);display:flex;flex-direction:column;padding:12px 0;flex-shrink:0}
			nav .brand{padding:14px 16px;font-size:15px;font-weight:700;color:var(--accent);letter-spacing:2px;margin-bottom:8px}
			nav a{display:flex;align-items:center;gap:8px;padding:9px 16px;color:var(--fg);text-decoration:none;font-size:12px;transition:background .12s}
			nav a:hover,nav a.active{background:var(--card);color:var(--accent)}
			nav .sep{border-top:1px solid var(--border);margin:8px 0}
			main{flex:1;overflow-y:auto;padding:20px 28px}
			h1{font-size:16px;color:var(--accent);margin-bottom:16px;letter-spacing:1px}
			h2{font-size:13px;color:var(--accent);margin-bottom:8px}
			.card{background:var(--card);border:1px solid var(--border);border-radius:5px;padding:14px;margin-bottom:10px}
			.badge{padding:2px 7px;border-radius:3px;font-size:10px;font-weight:600}
			.badge-ok{background:var(--ok);color:#fff}.badge-err{background:var(--err);color:#fff}.badge-warn{background:var(--warn);color:#000}.badge-dim{background:var(--dim);color:#fff}
			.row{display:flex;gap:12px;flex-wrap:wrap}
			.col{flex:1;min-width:200px}
			.status-grid{display:flex;gap:12px;margin-bottom:16px}
			.status-box{flex:1;text-align:center;padding:18px 12px;background:var(--card);border:1px solid var(--border);border-radius:5px}
			.status-box .val{font-size:22px;font-weight:700;color:var(--accent)}
			.status-box .lbl{font-size:10px;color:var(--dim);margin-top:4px}
			.terminal-box{background:#0a1a1a;border:1px solid var(--border);border-radius:5px;padding:12px;font-family:monospace;font-size:11px;text-transform:none;max-height:400px;overflow-y:auto;white-space:pre-wrap;line-height:1.5;color:#a0c8c8}
			.terminal-box .line{padding:2px 0}
			.terminal-box .thinking{color:var(--warn)}
			.terminal-box .tool{color:var(--accent)}
			.terminal-box .error{color:var(--err)}
			.terminal-box .stream{color:var(--fg)}
			table{width:100%;border-collapse:collapse;font-size:11px}
			th,td{padding:7px 10px;text-align:left;border-bottom:1px solid var(--border)}
			th{color:var(--accent);font-size:10px}
			td{text-transform:none}
			form{display:flex;gap:8px;margin-bottom:12px}
			input,select,textarea{background:var(--card);border:1px solid var(--border);color:var(--fg);padding:8px 10px;border-radius:4px;font-family:monospace;font-size:12px;flex:1;text-transform:none}
			button{background:var(--accent);color:var(--bg);border:none;padding:8px 16px;border-radius:4px;font-weight:700;cursor:pointer;font-size:12px;text-transform:uppercase;letter-spacing:1px;transition:opacity .15s}
			button:hover{opacity:.85}
			button:disabled{opacity:.4;cursor:default}
			.htmx-indicator{display:none}.htmx-request .htmx-indicator{display:inline}.htmx-request.htmx-indicator{display:inline}
			.spin{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
		</style>
		<script src="/static/htmx.min.js"></script>
	</head>
	<body hx-ext="sse">
		<nav>
			<div class="brand">⚕ Gormes</div>
			<a href="/" class={ templ.KV("active", title == "Dashboard") }>📊 Dashboard</a>
			<a href="/chat" class={ templ.KV("active", title == "Chat") }>💬 Chat</a>
			<a href="/sessions" class={ templ.KV("active", title == "Sessions") }>📋 Sessions</a>
			<div class="sep"></div>
			<a href="/skills" class={ templ.KV("active", title == "Skills") }>📦 Skills</a>
			<a href="/cron" class={ templ.KV("active", title == "Cron") }>⏰ Cron</a>
			<a href="/models" class={ templ.KV("active", title == "Models") }>🧠 Models</a>
			<a href="/config" class={ templ.KV("active", title == "Config") }>⚙️ Config</a>
			<a href="/env" class={ templ.KV("active", title == "Env") }>🔑 Env</a>
			<div class="sep"></div>
			<a href="/system" class={ templ.KV("active", title == "System") }>🖥️ System</a>
			<a href="/logs" class={ templ.KV("active", title == "Logs") }>📜 Logs</a>
			<div class="sep"></div>
			<div style="padding:9px 16px;color:var(--dim);font-size:10px" id="nav-status">
				Connecting…
			</div>
		</nav>
		<main>
			{ children... }
		</main>
		<div id="nav-status" sse-swap="status" hx-swap="innerHTML"></div>
	</body>
	</html>
}
