---
import SiteLayout from '../layouts/SiteLayout.astro';
import { posts } from '../lib/posts.js';
---

<SiteLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">Engineering notes from the loop</p>
      <h1>TrebuchetDynamics Engineering</h1>
      <p class="lede">
        Field notes on validation-gated agentic engineering, autonomous porting,
        and the Gormes runtime that makes the methodology inspectable.
      </p>
    </div>
    <figure class="hero-visual">
      <img src="/static/go-gopher-bear-lowpoly.png" width="640" height="640" alt="Low-poly Gormes runtime mascot" />
      <figcaption>Gormes is the receipt; the porting loop is the product.</figcaption>
    </figure>
  </section>

  <section class="post-list" aria-label="Published posts">
    {posts.map((post) => (
      <article class="post-card">
        <div>
          <h2><a href={post.url}>{post.title}</a></h2>
          <p>{post.summary}</p>
        </div>
        <time datetime={post.date}>{post.date}</time>
      </article>
    ))}
  </section>
</SiteLayout>
