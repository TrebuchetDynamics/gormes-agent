{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trebuchetdynamics.com/schemas/agentic-porting-kit-progress.schema.json",
  "title": "Agentic Porting Kit Progress",
  "type": "object",
  "required": ["project", "source", "target", "rows"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "target": {"type": "object"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "name",
        "status",
        "contract",
        "source_refs",
        "write_scope",
        "test_commands",
        "acceptance",
        "done_signal"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "in_progress", "complete"]},
        "contract": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "write_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "test_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "done_signal": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
