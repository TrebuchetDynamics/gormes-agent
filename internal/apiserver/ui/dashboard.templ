package ui

templ Dashboard() {
	@layout("Dashboard") {
		<div class="status-grid" id="status-bar" hx-get="/dashboard/status" hx-trigger="load, every 5s" hx-swap="innerHTML">
			<div class="status-box"><div class="val">—</div><div class="lbl">Phase</div></div>
			<div class="status-box"><div class="val">—</div><div class="lbl">Model</div></div>
			<div class="status-box"><div class="val">—</div><div class="lbl">Session</div></div>
		</div>
		<div class="row">
			<div class="col">
				<div class="card">
					<h2>🧠 Brain Feed</h2>
					<div class="terminal-box" id="brain-feed"
						hx-ext="sse"
						sse-connect="/dashboard/events"
						sse-swap="frame"
						hx-swap="beforeend"
						style="max-height:500px">
						<div class="line thinking">Waiting for agent activity…</div>
					</div>
				</div>
				<div class="card">
					<h2>📋 Recent Sessions</h2>
					<div id="session-list" hx-get="/dashboard/sessions-fragment" hx-trigger="load, every 30s" hx-swap="innerHTML">
						<div style="color:var(--dim)">Loading sessions…</div>
					</div>
				</div>
			</div>
			<div class="col">
				<div class="card">
					<h2>🎯 Task Injection</h2>
					<form hx-post="/agent/execute" hx-target="#task-result" hx-swap="innerHTML">
						<input type="text" name="prompt" placeholder="Inject new directive…" required/>
						<button type="submit">
							<span class="htmx-indicator spin">⏳</span>
							<span>Execute</span>
						</button>
					</form>
					<div id="task-result"></div>
				</div>
				<div class="card">
					<h2>🧩 Memory Nodes</h2>
					<div id="memory-list" hx-get="/dashboard/memory" hx-trigger="load" hx-swap="innerHTML">
						<div style="color:var(--dim)">Loading memory…</div>
					</div>
					<div id="memory-details" style="margin-top:8px"></div>
				</div>
			</div>
		</div>
	}
}
