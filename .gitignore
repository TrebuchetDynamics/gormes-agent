# ── Generated codemap files (clog builder context) ────
codemap.md
hermes-knowledge-graph.json

# ── Build outputs (Makefile writes to bin/) ──────────
bin/
/gormes
/builder-loop
/planner-loop
/progress

# ── Go binaries for other platforms ──────────────────
*.exe
*.dll
*.so
*.dylib
*.a

# ── Go test / coverage / profile artifacts ───────────
*.test
*.out
coverage.out
coverage.html
*.prof
*.pprof
__pycache__/
*.pyc

# ── Runtime logs and crash dumps ─────────────────────
gormes.log
crash-*.log
.pi/gormes-loop/*.jsonl
.pi/development-goal/
.pi/auto-folder-refactor-sessions/
.pi/candidates-folder-refactor/
**/.pi/development-goal/
**/.pi/auto-folder-refactor-sessions/
**/.pi/auto-folder-refactor-state/
**/.pi/candidates-folder-refactor/
**/.pi/folder-refactor/

# ── Local environment backups (may contain credentials) ──
.env.backup.*

# ── Local state directories (when run in-repo) ───────
.env
.gormes/
.hermes/
.codex/
.wrangler/
.superpowers/
.worktrees/

# ── Local upstream reference checkouts ───────────────
