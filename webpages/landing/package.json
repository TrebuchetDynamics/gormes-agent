{
  "name": "www-gormes-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs",
    "dev": "node ../scripts/with-compatible-node.mjs astro dev --host 127.0.0.1 --port 8080",
    "build": "node ../scripts/with-compatible-node.mjs astro build",
    "preview": "node ../scripts/with-compatible-node.mjs astro preview --host 127.0.0.1 --port 8080",
    "test:data": "node --test ./src/data/site.test.mjs",
    "test:sync-assets": "node --test ./scripts/asset-sync.test.mjs",
    "test:e2e": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^6.2.1",
    "tailwindcss": "^4.1.17"
  }
}
