# ── Build outputs (Makefile writes to bin/) ──────────
bin/
/gormes
/builder-loop
/planner-loop

# ── Go binaries for other platforms ──────────────────
*.exe
*.dll
*.so
*.dylib
*.a

# ── Go test / coverage / profile artifacts ───────────
*.test
*.out
coverage.out
coverage.html
*.prof
*.pprof

# ── Runtime logs and crash dumps ─────────────────────
gormes.log
crash-*.log

# ── Local state directories (when run in-repo) ───────
.env
.gormes/
.hermes/
.codex/
.wrangler/
.superpowers/
.worktrees/

# ── Local upstream reference checkouts ───────────────
hermes-agent/
openclaw/

# ── Agent/orchestrator scratch ───────────────────────
scripts/.swarm/
.claude/worktrees/

# ── Docs/site generated artifacts ────────────────────
docs/www-tests/node_modules/
docs/www-tests/test-results/
webpages/docs/www-tests/test-results/
www.gormes.ai/data/

# claude-flow swarm coordination state (created by `npx claude-flow swarm init`)
.claude-flow/
.swarm/
